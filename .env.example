# ==============================================================================
# TaskFlow v2 (TodoWeb v2) - Environment Variables Template
# ==============================================================================
# Salin file ini menjadi `.env.local` lalu isi dengan nilai kredensial riil Anda.
# JANGAN PERNAH meng-commit file `.env.local` atau kunci rahasia ke repositori Git!
# ==============================================================================

# Supabase Public Configuration
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret (OPSIONAL / UNTUK SERVER-SIDE ADMIN SAJA)
# PENTING: Jangan gunakan prefix NEXT_PUBLIC_ agar tidak bocor ke browser client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL (Digunakan untuk Redirect OAuth Google)
NEXT_PUBLIC_APP_URL=http://localhost:3000

